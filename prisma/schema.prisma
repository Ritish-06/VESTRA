generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          String         @default("CLIENT") // CLIENT | ATELIER_ADMIN
  loyaltyTier   String         @default("Atelier Circle")
  aesthetic     String?
  heightCm      Int?
  typicalSize   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      Wishlist?
  savedOutfits  SavedOutfit[]
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  address     String
  city        String
  state       String?
  postalCode  String
  country     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  products    Product[]
}

model Collection {
  id          String    @id @default(uuid())
  name        String
  season      String
  tagline     String
  description String
  coverImage  String
  palette     String    // JSON array
  products    Product[]
}

model Product {
  id             String           @id @default(uuid())
  name           String
  subtitle       String
  description    String
  editorialQuote String
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  collectionId   String
  collection     Collection       @relation(fields: [collectionId], references: [id])
  price          Float
  originalPrice  Float?
  geometryType   String           // trench_coat, tailored_blazer, silk_shirt, etc.
  fabricName     String
  fabricOrigin   String
  fabricWeight   Int
  fabricWeave    String
  rating         Float            @default(5.0)
  reviewCount    Int              @default(1)
  isNew          Boolean          @default(false)
  isBestseller   Boolean          @default(false)
  isLimited      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName      String
  colorHex       String
  colorThree     String
  size           String
  sku            String      @unique
  inventoryCount Int         @default(10)
  cartItems      CartItem[]
  orderItems     OrderItem[]
}

model Cart {
  id           String     @id @default(uuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  subtotal        Float
  discountAmount  Float       @default(0)
  taxAmount       Float       @default(0)
  shippingAmount  Float       @default(0)
  total           Float
  status          String      @default("confirmed") // confirmed, tailoring, quality_inspection, in_transit, delivered
  addressSnapshot String      // JSON string
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  payment         Payment?
  shipment        Shipment?
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  price     Float
}

model Payment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String   // STRIPE | VESTRA_VAULT
  transactionRef String   @unique
  amount         Float
  status         String   // COMPLETED | PENDING
  createdAt      DateTime @default(now())
}

model Shipment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String   @default("Private Atelier Courier")
  trackingNumber String   @unique
  status         String   @default("in_transit")
  timeline       String   // JSON string of timeline stages
  createdAt      DateTime @default(now())
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountPct    Int
  description    String
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
}

model SavedOutfit {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  occasion       String
  description    String
  piecesSnapshot String   // JSON array of product references
  totalPrice     Float
  createdAt      DateTime @default(now())
}

