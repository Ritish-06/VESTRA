# Copy to .env and fill in values.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vestra?schema=public"

# Auth.js — generate with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Razorpay test-mode keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Allow the clearly-labelled TEST MODE payment provider when Razorpay keys
# are not configured. MUST be "false" for a real production store.
ALLOW_TEST_PAYMENTS=true

# Admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@vestra.store"
SEED_ADMIN_PASSWORD="change-me"

